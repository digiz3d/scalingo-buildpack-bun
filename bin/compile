#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -euo pipefail

BUILD_DIR=${1:?BUILD_DIR is required}
CACHE_DIR=${2:?CACHE_DIR is required}
ENV_DIR=${3:-}

if [[ -d "$ENV_DIR" ]]; then
  for env_file in "$ENV_DIR"/*; do
    [[ -f "$env_file" ]] || continue
    export "$(basename "$env_file")=$(<"$env_file")"
  done
fi

VERSION_FILE="$BUILD_DIR/.bun-version"
if [[ ! -s "$VERSION_FILE" ]]; then
  echo "A non-empty .bun-version file is required." >&2
  exit 1
fi

BUN_VERSION=$(tr -d '\r\n' < "$VERSION_FILE")
if [[ ! "$BUN_VERSION" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Invalid Bun version in .bun-version: $BUN_VERSION" >&2
  exit 1
fi
BUN_VERSION=${BUN_VERSION#v}

echo "Installing Bun $BUN_VERSION"
export BUN_INSTALL="$BUILD_DIR"
export PATH="$BUILD_DIR/bin:$PATH"
curl -fsSL --retry-connrefused --retry 3 https://bun.sh/install | bash -s -- "bun-v$BUN_VERSION"

INSTALLED_VERSION=$(bun --version)
if [[ "$INSTALLED_VERSION" != "$BUN_VERSION" ]]; then
  echo "Expected Bun $BUN_VERSION, installed $INSTALLED_VERSION." >&2
  exit 1
fi
echo "Installed Bun $INSTALLED_VERSION"

cd "$BUILD_DIR"
echo "Installing dependencies"
bun install --frozen-lockfile --cache-dir "$CACHE_DIR/bun"

echo "Running build script if present"
bun run --if-present build
